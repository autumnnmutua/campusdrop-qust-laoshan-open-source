          }
        },
        "deliveryMode": {
          "type": "string",
          "enum": [
            "DOWNSTAIRS",
            "ROOM"
          ]
        },
        "slotDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "slotCode": {
          "type": "string",
          "enum": [
            "NOON",
            "EVENING",
            "NIGHT"
          ]
        },
        "dropPlace": {
          "type": "string",
          "enum": [
            "LIBRARY",
            "SOUTH_CANTEEN",
            "NORTH_CANTEEN",
            "STADIUM",
            "SOUTH_GATE",
            "WEST_GATE",
            "EAST_GATE"
          ]
        }
      },
      "required": [
        "parcelIds",
        "deliveryMode"
      ],
      "additionalProperties": false
    },
    "ruleCreate": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
