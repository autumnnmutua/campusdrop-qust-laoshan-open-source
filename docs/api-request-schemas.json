        "weekdays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "slotCode": {
          "type": "string",
          "enum": [
            "NOON",
            "EVENING",
            "NIGHT"
          ]
        },
        "deliveryMode": {
          "type": "string",
          "enum": [
            "DOWNSTAIRS",
            "ROOM"
          ]
        },
        "dropPlace": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "LIBRARY",
                "SOUTH_CANTEEN",
                "NORTH_CANTEEN",
                "STADIUM",
                "SOUTH_GATE",
                "WEST_GATE",
                "EAST_GATE"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "weekdays",
        "slotCode",
        "deliveryMode"
      ],
      "additionalProperties": false
    },
    "ruleUpdate": {
