          "type": "string",
          "enum": [
            "SUPER_ADMIN",
            "ZONE_ADMIN",
            "BUILDING_ADMIN",
            "DELIVERY_STAFF"
          ]
        },
        "scopes": {
          "maxItems": 19,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "campusId": {
                "type": "string",
                "const": "QUST_LAOSHAN"
              },
              "zone": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "SOUTH",
                      "NORTH"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "buildingCode": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(SOUTH|NORTH)_\\d{2}$"
                  },
