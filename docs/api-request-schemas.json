      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^[a-z0-9_]{3,32}$"
        },
        "password": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128
