{
  "name": "campusdrop-qust-laoshan",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.workers.config.ts --host 127.0.0.1",
    "build": "vite build && node scripts/check-static-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "types:check": "wrangler types src/worker/bindings.d.ts --env-interface WorkerBindings --include-runtime false --strict-vars false --check",
    "build:production": "node scripts/release.mjs build",
    "production:check": "node scripts/release.mjs check",
    "deploy": "node scripts/release.mjs deploy",
    "deploy:dry-run": "node scripts/release.mjs dry-run",
    "db:migrate:production": "node scripts/release.mjs migrate",
    "security:check": "node scripts/security-check.mjs",
    "verify": "node scripts/verify.mjs",
    "deploy:staging": "node scripts/release.mjs deploy staging",
    "db:migrate:staging": "node scripts/release.mjs migrate staging",
    "staging:check": "node scripts/release.mjs check staging",
    "api:generate": "node scripts/api-contracts.mjs --write",
    "api:check": "node scripts/api-contracts.mjs",
    "dev:static": "vite --host 127.0.0.1",
    "build:workers": "vite build --config vite.workers.config.ts",
    "deploy:cloudbase": "node scripts/deploy-cloudbase.mjs"
  },
  "dependencies": {
    "@netlify/functions": "^6.0.0",
    "dialog-polyfill": "^0.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@eslint/js": "^9.39.0",
    "@types/dialog-polyfill": "^0.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0",
    "wrangler": "^4.129.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
